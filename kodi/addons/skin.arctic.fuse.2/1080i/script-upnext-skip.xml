<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3010</defaultcontrol>
    <controls>
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="250" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="250" />
            </animation>
            <right>60</right>
            <bottom>100</bottom>
            <width>260</width>
            <height>68</height>

            <!-- Dark backing pill -->
            <control type="image">
                <width>260</width>
                <height>68</height>
                <texture border="20" colordiffuse="e6141414">common/box.png</texture>
            </control>

            <!-- Skip Intro Button (focused high-contrast pill, manual click only) -->
            <control type="button" id="3010">
                <width>260</width>
                <height>68</height>
                <label>$INFO[Window.Property(label)]</label>
                <font>font_main_bold</font>
                <textcolor>eeffffff</textcolor>
                <focusedcolor>ff121212</focusedcolor>
                <align>left</align>
                <aligny>center</aligny>
                <textoffsetx>66</textoffsetx>
                <texturefocus border="20" colordiffuse="f2ffffff">common/box.png</texturefocus>
                <texturenofocus border="20" colordiffuse="cc181818">common/box.png</texturenofocus>
                <pulseonselect>no</pulseonselect>
            </control>

            <!-- Crisp skip icon (forward-step, not 10s jump) -->
            <control type="image">
                <left>24</left>
                <top>20</top>
                <width>28</width>
                <height>28</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="ff121212">special://skin/extras/icons/forward-step.png</texture>
                <visible>Control.HasFocus(3010)</visible>
            </control>
            <control type="image">
                <left>24</left>
                <top>20</top>
                <width>28</width>
                <height>28</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="eeffffff">special://skin/extras/icons/forward-step.png</texture>
                <visible>!Control.HasFocus(3010)</visible>
            </control>
        </control>
    </controls>
</window>
