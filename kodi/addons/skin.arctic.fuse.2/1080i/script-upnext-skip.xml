<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3010</defaultcontrol>
    <include>Animation_FadeIn</include>
    <controls>
        <control type="group">
            <right>60</right>
            <bottom>100</bottom>
            <width>320</width>
            <height>60</height>

            <!-- Background Pill -->
            <control type="image">
                <width>320</width>
                <height>60</height>
                <texture colordiffuse="e6181818">common/box.png</texture>
                <bordertexture colordiffuse="40ffffff" border="2">common/box.png</bordertexture>
            </control>

            <!-- Skip Button -->
            <control type="button" id="3010">
                <width>320</width>
                <height>60</height>
                <label>⏩ $INFO[Window.Property(label)]</label>
                <font>font_small_bold</font>
                <textcolor>eeffffff</textcolor>
                <focusedcolor>00ffff</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus colordiffuse="3000ffff" border="5">common/box.png</texturefocus>
                <texturenofocus colordiffuse="00ffffff">common/box.png</texturenofocus>
                <pulseonselect>yes</pulseonselect>
            </control>
        </control>
    </controls>
</window>
