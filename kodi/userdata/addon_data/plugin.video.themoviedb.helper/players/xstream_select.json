{
    "name": "xStream Scraper (Quelle manuell wählen)",
    "plugin": "script.module.xstreamscraper",
    "priority": 15,
    "is_resolvable": "true",
    "assert": {
        "play_movie": ["tmdb"],
        "play_episode": ["tmdb", "season", "episode"]
    },
    "play_movie": "plugin://script.module.xstreamscraper/?id={tmdb}&select=true",
    "play_episode": "plugin://script.module.xstreamscraper/?id={tmdb}&season={season}&episode={episode}&select=true",
    "make_playlist": "false"
}
